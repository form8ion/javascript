{
  "name": "@form8ion/javascript",
  "description": "JavaScript language plugin for the @form8ion toolset",
  "license": "MIT",
  "version": "0.0.0-semantically-released",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15"
  },
  "author": "Matt Travi <npm@travi.org> (https://matt.travi.org)",
  "repository": "form8ion/javascript",
  "bugs": "https://github.com/form8ion/javascript/issues",
  "homepage": "https://www.npmjs.com/package/@form8ion/javascript",
  "runkitExampleFilename": "./example.js",
  "exports": {
    "module": "./lib/index.js",
    "import": "./lib/index.js"
  },
  "main": "./lib/index.js",
  "sideEffects": false,
  "scripts": {
    "pretest": "run-s build",
    "test": "npm-run-all --print-label --parallel lint:* --parallel test:*",
    "lint:engines": "ls-engines",
    "lint:gherkin": "gplint --config .gplintrc.json",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "run-s 'lint:js -- --fix'",
    "lint:lockfile": "lockfile-lint",
    "lint:peer": "npm ls >/dev/null",
    "lint:publish": "publint --strict",
    "lint:sensitive": "ban",
    "test:unit": "run-s 'test:unit:base -- --coverage'",
    "test:unit:base": "NODE_ENV=test DEBUG=any vitest run src/",
    "test:integration": "run-s 'test:integration:base -- --profile noWip'",
    "pretest:integration:base": "run-s build",
    "test:integration:base": "NODE_OPTIONS=--enable-source-maps DEBUG=${DEBUG:+$DEBUG,}any cucumber-js test/integration",
    "test:integration:debug": "DEBUG=test:* run-s test:integration",
    "test:integration:focus": "run-s 'test:integration:base -- --profile focus'",
    "test:integration:wip": "run-s 'test:integration:base -- --profile wip'",
    "test:integration:wip:debug": "DEBUG=test:* run-s 'test:integration:wip'",
    "prebuild": "run-s clean",
    "build": "npm-run-all --print-label --parallel build:*",
    "build:js": "rollup --config",
    "clean": "rimraf ./lib",
    "pregenerate:md": "run-s build",
    "generate:md": "remark . --output",
    "prepack": "run-s build",
    "prepare": "husky",
    "temp-disabled:lint:md": "remark . --frail",
    "watch": "run-s 'build:js -- --watch'"
  },
  "files": [
    "example.js",
    "lib/",
    "templates/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "dependencies": {
    "@form8ion/c8": "^1.0.0-beta.2",
    "@form8ion/commit-convention": "^9.0.0-beta.2",
    "@form8ion/config-file": "^1.1.1",
    "@form8ion/core": "^5.0.0-beta.15",
    "@form8ion/eslint": "^8.0.0-beta.4",
    "@form8ion/husky": "^8.0.0-beta.4",
    "@form8ion/javascript-core": "^13.0.0",
    "@form8ion/plugins-core": "^1.0.0-beta.1",
    "@form8ion/prettier": "^3.0.0",
    "@hapi/hoek": "^11.0.0",
    "camelcase": "^9.0.0",
    "deepmerge": "^4.2.2",
    "execa": "^10.0.0",
    "ini": "^7.0.0",
    "joi": "^18.2.1",
    "mustache": "^4.2.0",
    "npm-conf": "^1.1.3",
    "sort-object-keys": "^2.0.0",
    "touch": "^3.1.0",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@form8ion/commitlint-config": "3.0.2",
    "@form8ion/eslint-config": "7.1.0-beta.1",
    "@form8ion/eslint-config-cucumber": "1.4.1",
    "@form8ion/eslint-config-vitest": "1.1.0",
    "@form8ion/remark-lint-preset": "6.0.7",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@travi/any": "3.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "ban-sensitive-files": "1.10.11",
    "chai": "6.3.0",
    "cz-conventional-changelog": "3.3.0",
    "debug": "4.4.3",
    "gplint": "2.6.0",
    "husky": "9.1.7",
    "js-yaml": "5.4.3",
    "lockfile-lint": "5.0.1",
    "ls-engines": "0.10.1",
    "mock-fs": "5.5.0",
    "npm-run-all2": "9.0.3",
    "publint": "0.3.25",
    "remark-cli": "12.0.1",
    "remark-toc": "9.0.0",
    "remark-usage": "11.0.1",
    "rimraf": "6.1.3",
    "rollup": "4.64.1",
    "rollup-plugin-auto-external": "2.0.0",
    "testdouble": "3.23.0",
    "vitest": "5.0.3",
    "vitest-when": "1.0.0"
  }
}
